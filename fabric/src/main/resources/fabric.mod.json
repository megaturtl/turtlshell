{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "MIT",
  "icon": "assets/turtlshell/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cc.turtl.turtlshell.fabric.TurtlShellFabric"
    ],
    "modmenu": [
      "cc.turtl.turtlshell.fabric.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "turtlshell.mixins.json",
      "environment": "client"
    },
    {
      "config": "turtlshell.mixins.fabric.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": "${java_version}",

    "yet_another_config_lib_v3": ">=3.8.1"
  }
}
