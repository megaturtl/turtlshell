{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_display_name}",
  "description": "${mod_desc}",
  "authors": [
    "${mod_author}"
  ],
  "license": "MIT",
  "icon": "assets/turtlshell/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cc.turtl.turtlshell.fabric.TurtlShellFabric"
    ],
    "modmenu": [
      "cc.turtl.turtlshell.fabric.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "turtlshell.mixins.json",
      "environment": "client"
    },
    {
      "config": "turtlshell.mixins.fabric.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",

    "yet_another_config_lib_v3": ">=3.8.1"
  }
}
