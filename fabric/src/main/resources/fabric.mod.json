{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "MIT",
  "icon": "assets/turtlshell/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "cc.turtl.turtlshell.TurtlShellFabric"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "cc.turtl.turtlshell.client.TurtlShellClientFabric"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "cc.turtl.turtlshell.client.integration.ModMenuIntegration"
      }
    ]
  },
  "mixins": [
    "turtlshell-common.mixins.json",
    "turtlshell-fabric.mixins.json"
  ],
  "accessWidener": "turtlshell-common.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "minecraft": "${minecraft_version}",
    "java": "${java_version}",

    "yet_another_config_lib_v3": ">=3.8.1"
  }
}
